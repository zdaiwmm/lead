[Unit]
Description=Lead shared Codex machine credential broker
Requires=lead-codex-node.socket
After=lead-codex-node.socket network-online.target
Wants=network-online.target

[Service]
Type=exec
User=lead-codex-supervisor
Group=lead-codex-supervisor
LoadCredential=node.json:/etc/lead-codex-node/node.json
ExecStart=/usr/bin/python3 -I -B /opt/lead-codex-node/node_broker.py
UMask=0077
Restart=on-abnormal
RestartSec=10
KillMode=control-group
TimeoutStopSec=45
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/var/lib/lead-codex -/srv/lead-prod-vault -/etc/lead-home-release -/run/lead-home -/run/lead-executor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target

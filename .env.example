DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional extra model names allowed in the admin console, comma separated.
LEAD_ALLOWED_MODELS=
# Optional OpenAI service. Admin model references use openai:<model>.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ALLOWED_MODELS=
# Defaults for new/unconfigured Agents. Existing unqualified references retain DeepSeek routing.
LEAD_MODEL_PROVIDER=deepseek
# Maximum simultaneous browser profiles; each profile has its own process and storage.
LEAD_BROWSER_CONCURRENCY=3
LEAD_DAILY_TOKEN_LIMIT=1000000000
# Optional browser-use public exploration; social accounts stay in Camoufox.
LEAD_BROWSER_USE_ENABLED=0
# Public HTTPS origin is required before connecting an external product website.
LEAD_PUBLIC_URL=http://127.0.0.1:3100
# Per-agent proxy URLs are placed here as LEAD_PROXY_<AGENT_UUID_WITHOUT_DASHES>.
# A configured proxy never falls back to a direct connection.

# Fixed IP expected for the corresponding profile, never inferred from shared egress.
# LEAD_EXPECTED_IP_<AGENT_UUID_WITHOUT_DASHES>=203.0.113.10
# Local owner mode allows explicit owned-channel verification. Production rechecks egress before writes.
LEAD_DEPLOYMENT_MODE=local_owner

# Operator-only multiuser deployment (local_owner remains the local default).
LEAD_AUTH_MODE=local_owner
LEAD_OIDC_ISSUER=
LEAD_OIDC_CLIENT_ID=
LEAD_OIDC_CLIENT_SECRET=
# LEAD_DB_HOST=postgres.example
# LEAD_DB_PORT=5432
# LEAD_DB_NAME=lead
# LEAD_DB_SSLMODE=verify-full
# LEAD_DB_CA_FILE=/etc/lead/db-ca.pem
# LEAD_DB_USER=lead_runtime
# LEAD_DB_PASSWORD=
# LEAD_DB_AUTH_USER=lead_auth
# LEAD_DB_AUTH_PASSWORD=
# LEAD_DB_OWNER_USER=lead_owner
# LEAD_DB_OWNER_PASSWORD=
# LEAD_TEMPORAL_ADDRESS=workflow.example:7233
# LEAD_TEMPORAL_NAMESPACE=lead-prod
# LEAD_TEMPORAL_TLS=1
# LEAD_TEMPORAL_CA_FILE=/etc/lead/workflow-ca.pem
# LEAD_TEMPORAL_CERT_FILE=/etc/lead/workflow-cert.pem
# LEAD_TEMPORAL_KEY_FILE=/etc/lead/workflow-key.pem
# LEAD_TEMPORAL_API_KEY=
LEAD_BACKUP_AUTO=1
# Production requires an independent key path and verified remote copies.
# LEAD_BACKUP_KEY_FILE=/etc/lead/keys/backup.key
# LEAD_BACKUP_S3_URI=s3://lead-private-backups/encrypted
# LEAD_S3_ENDPOINT=https://storage.example
# LEAD_S3_REGION=us-east-1
# LEAD_S3_ACCESS_KEY_ID=
# LEAD_S3_SECRET_ACCESS_KEY=
# LEAD_S3_KMS_KEY_ID=
# LEAD_OTLP_TRACES_ENDPOINT=https://collector.example/v1/traces
# LEAD_NETWORK_NAMESPACE=1
